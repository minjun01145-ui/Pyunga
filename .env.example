# Public Firebase Web SDK settings (safe to expose in browser when Security Rules are correct)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only AI/API secrets belong in Firebase App Hosting secrets / Secret Manager.
# Never prefix server secrets with NEXT_PUBLIC_.

# Ollama server settings. For Ollama Cloud use https://ollama.com/api and keep the API key server-only.
# For a local Ollama server, use http://localhost:11434/api and leave OLLAMA_API_KEY empty.
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
# Direct Ollama Cloud API model name. Example: gpt-oss:120b
OLLAMA_MODEL=gpt-oss:120b
